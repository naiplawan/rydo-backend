# Development database only. Do not point tests at production.
DATABASE_URL=
APP_PORT=8080
# Exact browser origin, no trailing slash or path. HTTPS required except loopback.
WEB_APP_URL=
# Independent random values of at least 32 bytes each; no application defaults.
JWT_SIGNING_KEY=
PREVIEW_SIGNING_KEY=
# Required for the real, fixed LINE verification endpoint. No development bypass exists.
LINE_LOGIN_CHANNEL_ID=
